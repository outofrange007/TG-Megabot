# Telegram API credentials from https://my.telegram.org
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef
# Bot token from @BotFather
TG_BOT_TOKEN=123456789:AAAA-your-bot-token
# Numeric ID of the supergroup the bot mirrors into
TG_CHAT_ID=-1001234567890
# Comma-separated Telegram user IDs allowed to use the bot
TG_ALLOWED_USERS=123456789
# Seconds before temporary status messages are deleted (default 60)
STATUS_DELETE_DELAY=60
# Optional: cookies file inside the container for YouTube (mount it first)
#YT_COOKIES=/cookies.txt
# Optional: per-video caps in MiB (default 1900 each)
#YT_MAX_SIZE=1900
#NZ_MAX_SIZE=1900
# Optional: seconds to wait for the large-file choice; 0 disables the prompt
#LARGE_FILE_ASK_TIMEOUT=120